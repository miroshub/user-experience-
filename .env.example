# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# From MongoDB Atlas: Connect > Drivers. Put the database name "wuzzufny" before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/wuzzufny?retryWrites=true&w=majority

# Any long random text. Used from Phase 1 to sign login tokens.
JWT_SECRET=replace-with-a-long-random-string

# mock, gemini, haiku or sonnet. mock works without any key.
AI_MODEL=mock
GEMINI_API_KEY=
