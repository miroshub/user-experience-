# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# From MongoDB Atlas: Connect > Drivers. Put the database name "wuzzufny" before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/wuzzufny?retryWrites=true&w=majority

# Any long random text. Used from Phase 1 to sign login tokens.
JWT_SECRET=replace-with-a-long-random-string

# mock, gemini, haiku or sonnet. mock works without any key.
# If the key for the chosen model is empty, the app falls back to mock and says so in the console.
AI_MODEL=mock
# Free key from Google AI Studio (aistudio.google.com). Only needed for AI_MODEL=gemini.
GEMINI_API_KEY=
# Optional: another Gemini model id
GEMINI_MODEL=gemini-3-flash-preview
# Only needed for AI_MODEL=haiku or AI_MODEL=sonnet (console.anthropic.com).
ANTHROPIC_API_KEY=
